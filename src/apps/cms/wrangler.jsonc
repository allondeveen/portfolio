{
	"$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
	"name": "portfolio-cms-dev",
	"compatibility_date": "2025-08-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"bucket_name": "portfolio-assets-dev",
			"binding": "R2"
		}
	],
  "vars": {
    "CMS_ORIGIN": "https://cms-dev.allondeveen.com",
    "FRONTEND_URL": "https://dev.allondeveen.com",
    "MEDIA_URL": "https://media-dev.allondeveen.com",
    "ENVIRONMENT": "development"
  },
  "secrets": {
    "required": ["DATABASE_CONNECTIONSTRING", "OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY", "PAYLOAD_SECRET", "SEED_EMAIL", "SEED_PASS"]
  },
	// Here's how to configure an additional environment
	// It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
	"env": {
		"staging": {
			"name": "portfolio-cms-staging",
      "vars": {
        "CMS_ORIGIN": "https://cms-staging.allondeveen.com",
        "FRONTEND_URL": "https://staging.allondeveen.com",
        "MEDIA_URL": "https://media-staging.allondeveen.com",
        "MAINTENANCE_BUILD_HOOK_URL": "https://api.github.com/repos/allondeveen/portfolio/actions/workflows/deploy-maintenance-page.yml/dispatches",
        "MAINTENANCE_BUILD_REF": "staging",
        "ENVIRONMENT": "staging"
      },
      "secrets": {
        "required": ["DATABASE_CONNECTIONSTRING", "OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY", "PAYLOAD_SECRET", "MAINTENANCE_BUILD_HOOK_TOKEN"]
      },
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets-staging",
			    "remote": true
				}
			]
		},
		"production": {
			"name": "portfolio-cms",
      "vars": {
        "CMS_ORIGIN": "https://cms.allondeveen.com",
        "FRONTEND_URL": "https://www.allondeveen.com",
        "MEDIA_URL": "https://media.allondeveen.com",
        "MAINTENANCE_BUILD_HOOK_URL": "https://api.github.com/repos/allondeveen/portfolio/actions/workflows/deploy-maintenance-page.yml/dispatches",
        "MAINTENANCE_BUILD_REF": "main",
        "ENVIRONMENT": "production"
      },
      "secrets": {
        "required": ["DATABASE_CONNECTIONSTRING", "OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY", "PAYLOAD_SECRET", "MAINTENANCE_BUILD_HOOK_TOKEN"]
      },
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets",
			    "remote": true
				}
			]
		}
	}
}
