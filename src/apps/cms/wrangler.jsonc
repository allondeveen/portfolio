{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "portfolio-cms-dev",
	"compatibility_date": "2025-08-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "portfolio-cms-dev",
			"database_id": "DATABASE_ID"
		}
	],
  "kv_namespaces": [
    {
      "binding": "RUNTIME_CONFIG",
      "id": "3d86b9a726a64de6a5b75e3ef17b5891",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "MAINTENANCE",
      "service": "portfolio-maintenance",
      "remote": true
    }
  ],
	"r2_buckets": [
		{
			"bucket_name": "portfolio-assets-dev",
			"binding": "R2",
			"remote": true
		}
	],
	// Here's how to configure an additional environment
	// It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
	"env": {
		"staging": {
			"name": "portfolio-cms-staging",
      "routes": [
        {
          "pattern": "cms-staging.allondeveen.com",
          "custom_domain": true
        }
      ],
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "fe1310f3-b1d1-40b7-973d-46abf7772f72",
					"database_name": "portfolio-cms-staging",
					"remote": true
				}
			],
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "85b4698d48da467cb17d7f9b68c3cc23"
        }
      ],
      "services": [
        {
          "binding": "MAINTENANCE",
          "service": "portfolio-maintenance"
        }
      ],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets-staging",
			    "remote": true
				}
			]
		},
		"production": {
			"name": "portfolio-cms",
      "routes": [
        {
          "pattern": "cms.allondeveen.com",
          "custom_domain": true
        }
      ],
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "41ebaab8-e581-48b0-9626-2db1b1679111",
					"database_name": "portfolio-cms",
					"remote": true
				}
			],
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "f852766a34604b699556410e7dc397a8"
        }
      ],
      "services": [
        {
          "binding": "MAINTENANCE",
          "service": "portfolio-maintenance"
        }
      ],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets",
			    "remote": true
				}
			]
		}
	}
}
