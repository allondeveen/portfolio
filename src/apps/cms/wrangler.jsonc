{
	"$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
	"name": "portfolio-cms-dev",
	"compatibility_date": "2025-08-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "portfolio-cms-dev",
			"database_id": "DATABASE_ID"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "portfolio-assets-dev",
			"binding": "R2"
		}
	],
  "vars": {
    "CMS_ORIGIN": "https://cms-dev.allondeveen.com"
  },
  "secrets": {
    "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY", "SEED_EMAIL", "SEED_PASS"]
  },
	// Here's how to configure an additional environment
	// It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
	"env": {
		"staging": {
			"name": "portfolio-cms-staging",
      "vars": {
        "CMS_ORIGIN": "https://cms-staging.allondeveen.com"
      },
      "secrets": {
        "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY"]
      },
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "fe1310f3-b1d1-40b7-973d-46abf7772f72",
					"database_name": "portfolio-cms-staging",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets-staging",
			    "remote": true
				}
			]
		},
		"production": {
			"name": "portfolio-cms",
      "vars": {
        "CMS_ORIGIN": "https://cms.allondeveen.com"
      },
      "secrets": {
        "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET", "OAUTH_JWT_SIGNING_KEY"]
      },
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "41ebaab8-e581-48b0-9626-2db1b1679111",
					"database_name": "portfolio-cms",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets",
			    "remote": true
				}
			]
		}
	}
}
