{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "portfolio-cms-dev",
	"compatibility_date": "2025-08-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "portfolio-cms-dev",
			"database_id": "DATABASE_ID"
		}
	],
	"services": [
		// The service should match the "name" of your worker
		// {
		//   "binding": "WORKER_SELF_REFERENCE",
		//   "service": "my-app"
		// },
	],
	"r2_buckets": [
		{
			"bucket_name": "portfolio-assets-dev",
			"binding": "R2",
			"remote": true
		}
	],
	// Here's how to configure an additional environment
	// It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
	"env": {
		"staging": {
			"name": "portfolio-cms-staging",
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "fe1310f3-b1d1-40b7-973d-46abf7772f72",
					"database_name": "portfolio-cms-staging",
					"remote": true
				}
			],
			"services": [
				// The service should match the "name" of your worker
				// {
				//   "binding": "WORKER_SELF_REFERENCE",
				//   "service": "my-app-staging"
				// },
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets-staging",
			    "remote": true
				}
			]
		},
		"production": {
			"name": "portfolio-cms",
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "41ebaab8-e581-48b0-9626-2db1b1679111",
					"database_name": "portfolio-cms",
					"remote": true
				}
			],
			"services": [
				// The service should match the "name" of your worker
				// {
				//   "binding": "WORKER_SELF_REFERENCE",
				//   "service": "my-app-staging"
				// },
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "portfolio-assets",
			    "remote": true
				}
			]
		}
	}
}
