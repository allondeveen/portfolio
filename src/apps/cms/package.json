{
  "name": "@allondeveen-portfolio/cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node assets.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:app": "node assets.mjs && opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "dev": "concurrently -k -n assets,next \"node assets.mjs -w\" \"cross-env NODE_OPTIONS=--no-deprecation next dev\"",
    "devsafe": "rm -rf .next && rm -rf .open-next && node assets.mjs -w && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "dotenv -e .env -- node scripts/preview.mjs",
    "start": "node assets.mjs && cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "wrangler": "cross-env NODE_OPTIONS=--no-deprecation wrangler"
  },
  "dependencies": {
    "@allondeveen-portfolio/articles": "workspace:*",
    "@allondeveen-portfolio/blocks-property": "workspace:*",
    "@allondeveen-portfolio/client-credentials-flow": "workspace:*",
    "@allondeveen-portfolio/maintenance-content": "workspace:*",
    "@allondeveen-portfolio/media": "workspace:*",
    "@allondeveen-portfolio/menu": "workspace:*",
    "@allondeveen-portfolio/pages": "workspace:*",
    "@allondeveen-portfolio/projects": "workspace:*",
    "@allondeveen-portfolio/public-documents": "workspace:*",
    "@allondeveen-portfolio/seed": "workspace:*",
    "@allondeveen-portfolio/single-line-lexical": "workspace:*",
    "@allondeveen-portfolio/site-settings": "workspace:*",
    "@allondeveen-portfolio/slug-property": "workspace:*",
    "@allondeveen-portfolio/sync-hero-metadata": "workspace:*",
    "@allondeveen-portfolio/templates": "workspace:*",
    "@allondeveen-portfolio/topics": "workspace:*",
    "@allondeveen-portfolio/trpc": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@payloadcms/db-d1-sqlite": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/plugin-seo": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/storage-r2": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@trpc/server": "catalog:",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "catalog:",
    "cpx": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
