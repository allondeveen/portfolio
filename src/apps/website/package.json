{
  "name": "@allondeveen-portfolio/website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node assets.mjs && react-router build",
    "dev": "concurrently -k -n assets,react-router \"node assets.mjs -w\" \"react-router dev\"",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "rr-typegen": "react-router typegen",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@allondeveen-portfolio/client-credentials-flow": "workspace:*",
    "@allondeveen-portfolio/design-system": "workspace:*",
    "@allondeveen-portfolio/public-documents": "workspace:*",
    "@allondeveen-portfolio/trpc": "workspace:*",
    "@trpc/client": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "isbot": "^5.1.36",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "concurrently": "catalog:",
    "cpx": "catalog:",
    "tailwindcss": "^4.2.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
