{
  "name": "@allondeveen-portfolio/website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node assets.mjs && react-router build",
    "dev": "concurrently -k -n assets,react-router \"node assets.mjs -w\" \"react-router dev\"",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "rr-typegen": "react-router typegen",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@allondeveen-portfolio/client-credentials-flow": "workspace:*",
    "@allondeveen-portfolio/design-system": "workspace:*",
    "@allondeveen-portfolio/public-documents": "workspace:*",
    "@allondeveen-portfolio/trpc": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@vanilla-extract/css": "^1.21.2",
    "isbot": "^5.1.36",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "concurrently": "^10.0.4",
    "cpx": "^1.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "catalog:",
    "vite": "^8.0.3",
    "wrangler": "^4.118.0"
  }
}
