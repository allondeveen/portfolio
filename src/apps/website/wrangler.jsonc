/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-website-dev",
	"compatibility_date": "2026-08-06",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "9f36b6314d634c2794e25c7f6e8adebd",
      "remote": true
    }
  ],
	"assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "CMS",
      "service": "portfolio-cms-proxy"
    }
  ],
  "vars": {
    "CMS_URL": "https://cms-dev.allondeveen.com",
    "MEDIA_URL": "https://media-dev.allondeveen.com",
    "ENVIRONMENT": "development"
  },
  "secrets": {
    "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET"]
  },
  "env": {
    "staging" : {
      "name": "portfolio-website-staging",
      "secrets": {
        "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET"]
      },
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "0ea599ac72c84139875748a01e7b35f7"
        }
      ],
      "services": [
        {
          "binding": "CMS",
          "service": "portfolio-cms-staging"
        }
      ],
      "vars": {
        "CMS_URL": "https://cms-staging.allondeveen.com",
        "MEDIA_URL": "https://media-staging.allondeveen.com",
        "ENVIRONMENT": "staging"
      }
    },
    "production" : {
      "name": "portfolio-website",
      "secrets": {
        "required": ["OAUTH_CLIENT_ID", "OAUTH_CLIENT_SECRET"]
      },
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "e5e97de323504b98ad986a5528367378"
        }
      ],
      "services": [
        {
          "binding": "CMS",
          "service": "portfolio-cms"
        }
      ],
      "vars": {
        "CMS_URL": "https://cms.allondeveen.com",
        "MEDIA_URL": "https://media.allondeveen.com",
        "ENVIRONMENT": "production"
      }
    }
  }
}
