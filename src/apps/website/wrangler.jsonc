/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-website-dev",
	"compatibility_date": "2026-08-06",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
  "kv_namespaces": [
    {
      "binding": "RUNTIME_CONFIG",
      "id": "3d86b9a726a64de6a5b75e3ef17b5891",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "MAINTENANCE",
      "service": "portfolio-maintenance",
      "remote": true
    }
  ],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {  "directory": "./public/",  "binding": "ASSETS" },
  "env": {
    "staging" : {
      "name": "portfolio-website-staging",
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "85b4698d48da467cb17d7f9b68c3cc23"
        }
      ],
      "services": [
        {
          "binding": "MAINTENANCE",
          "service": "portfolio-maintenance"
        }
      ]
    },
    "production" : {
      "name": "portfolio-website",
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "f852766a34604b699556410e7dc397a8"
        }
      ],
      "services": [
        {
          "binding": "MAINTENANCE",
          "service": "portfolio-maintenance"
        }
      ]
    }
  }
}
