{
  "extends": "./tsconfig.json",
  "include": ["scripts/**/*.ts", "vite.config.ts", "vite.render.config.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
