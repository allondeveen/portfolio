/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-maintenance-dev",
	"compatibility_date": "2026-08-05",
	"main": "./workers/app.ts",
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
  "kv_namespaces": [
    {
      "binding": "RUNTIME_CONFIG",
      "id": "RUNTIME_CONFIG_ID"
    }
  ],
  "services": [
    {
      "binding": "CMS",
      "service": "portfolio-cms-proxy"
    },
    {
      "binding": "WEBSITE",
      "service": "portfolio-website-dev"
    }
  ],
  "vars": {
    "WEBSITE_HOST": "dev.allondeveen.com",
    "CMS_HOST": "cms-dev.allondeveen.com"
  },
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "portfolio-maintenance-staging",
      "routes": [
        {
          "pattern": "staging.allondeveen.com",
          "custom_domain": true
        }
        // {
        //   "pattern": "cms-staging.allondeveen.com",
        //   "custom_domain": true
        // }
      ],
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "85b4698d48da467cb17d7f9b68c3cc23"
        }
      ],
      "services": [
        // {
        //   "binding": "CMS",
        //   "service": "portfolio-cms-staging"
        // },
        {
          "binding": "WEBSITE",
          "service": "portfolio-website-staging"
        }
      ],
      "vars": {
        "WEBSITE_HOST": "staging.allondeveen.com",
        "CMS_HOST": "cms-staging.allondeveen.com"
      }
    },
    "production": {
      "name": "portfolio-maintenance",
      "routes": [
        {
          "pattern": "allondeveen.com",
          "custom_domain": true
        },
        {
          "pattern": "www.allondeveen.com",
          "custom_domain": true
        }
        // {
        //   "pattern": "cms.allondeveen.com",
        //   "custom_domain": true
        // }
      ],
      "kv_namespaces": [
        {
          "binding": "RUNTIME_CONFIG",
          "id": "f852766a34604b699556410e7dc397a8"
        }
      ],
      "services": [
        // {
        //   "binding": "CMS",
        //   "service": "portfolio-cms"
        // },
        {
          "binding": "WEBSITE",
          "service": "portfolio-website"
        }
      ],
      "vars": {
        "WEBSITE_HOST": "www.allondeveen.com",
        "CMS_HOST": "cms.allondeveen.com"
      }
    }
  }
}
