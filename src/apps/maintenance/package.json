{
  "name": "@allondeveen-portfolio/maintenance",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node assets.mjs && react-router build",
    "dev": "concurrently -k -n assets,react-router \"node assets.mjs -w\" \"react-router dev\"",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@allondeveen-portfolio/design-system": "workspace:*",
    "@allondeveen-portfolio/maintenance-mode": "workspace:*",
    "@allondeveen-portfolio/maintenance-page": "workspace:*",
    "@vanilla-extract/css": "^1.21.2",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@react-router/dev": "^8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "concurrently": "^10.0.4",
    "cpx": "^1.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.118.0"
  }
}
