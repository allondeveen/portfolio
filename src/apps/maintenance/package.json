{
  "name": "@allondeveen-portfolio/maintenance",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.build.vars --import tsx scripts/build.ts",
    "dev": "node --env-file-if-exists=.build.vars --import tsx scripts/dev.ts",
    "typecheck": "wrangler types && tsc -b",
    "deploy": "wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@allondeveen-portfolio/client-credentials-flow": "workspace:*",
    "@allondeveen-portfolio/design-system": "workspace:*",
    "@allondeveen-portfolio/maintenance-content": "workspace:*",
    "@allondeveen-portfolio/maintenance-mode": "workspace:*",
    "@allondeveen-portfolio/trpc": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@vanilla-extract/css": "^1.21.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.118.0"
  }
}
