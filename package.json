{
  "name": "@allondeveen-portfolio",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "cms:dev": "pnpm --filter @allondeveen-portfolio/cms dev",
    "cms:build": "pnpm --filter @allondeveen-portfolio/cms build",
    "cms:preview": "pnpm --filter @allondeveen-portfolio/cms preview",
    "cms:deploy": "pnpm --filter @allondeveen-portfolio/cms deploy",
    "maintenance:dev": "pnpm --filter @allondeveen-portfolio/maintenance dev",
    "maintenance:build": "pnpm --filter @allondeveen-portfolio/maintenance build",
    "maintenance:preview": "pnpm --filter @allondeveen-portfolio/maintenance preview",
    "maintenance:deploy": "pnpm --filter @allondeveen-portfolio/maintenance deploy",
    "website:dev": "pnpm --filter @allondeveen-portfolio/website dev",
    "website:build": "pnpm --filter @allondeveen-portfolio/website build",
    "website:preview": "pnpm --filter @allondeveen-portfolio/website preview",
    "website:deploy": "pnpm --filter @allondeveen-portfolio/website deploy",
    "payload": "pnpm --filter @allondeveen-portfolio/cms payload",
